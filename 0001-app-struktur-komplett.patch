+                        person = it,
+                        byId = byId,
+                        expandedAncestorsOf = expandedAncestorsOf,
+                        onToggleAncestors = onToggleAncestors,
+                        onTapCard = onTapCard,
+                        alwaysShowParents = false,
+                        isCenterCard = false
                     )
                 }
