 .../famly/ui/screens/tree/TreeScreen.kt       | 94 ++++---------------
 2 files changed, 25 insertions(+), 116 deletions(-)

diff --git a/app/src/main/java/com/beigel/famly/ui/screens/tree/TreeLayout.kt b/app/src/main/java/com/beigel/famly/ui/screens/tree/TreeLayout.kt
